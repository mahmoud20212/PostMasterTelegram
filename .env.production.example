# Non-secret Compose interpolation only. Never copy the old production .env.
# Pin to the locally built and audited image tag loaded on the server.
ONEPOST_IMAGE=onepost-fresh:release
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set only AFTER old polling/worker/beat are stopped, or use a distinct bot token.
ONEPOST_POLLING_HANDOFF=pending
